{
  "name": "@echo-agent/tui",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Echo's terminal shell: the interactive TUI and the first-run credential setup, packaged as the terminal implementation of the assembly layer's shell port. Requires Bun.",
  "dependencies": {
    "@echo-agent/base": "workspace:*",
    "@echo-agent/core": "workspace:*",
    "@earendil-works/pi-tui": "^0.84.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test test"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts"
    },
    "./testing": {
      "bun": "./src/testing.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "agent",
    "ai-agent",
    "llm",
