{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // 仓内解析必须走 `@echo-agent/core` exports 的 `bun` 支（指源码）。缺了这条，tsc 会取
    // `types` 支的 `dist/`——那是构建产物、不进仓，**新检出必红**（CI 实测 TS2307）。
    // 本机曾因残留 dist 而假绿。这也让 tsc 与 bun 运行时看到同一份文件。
    "customConditions": ["bun"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "bin"]
}
