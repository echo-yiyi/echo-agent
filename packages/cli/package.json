{
  "name": "echo-agent",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Echo's general agent: the official CLI and interactive TUI. The same agent runs interactively and through a Unix pipe. Requires Bun.",
  "bin": {
    "echo-agent": "./bin/echo-agent.ts"
  },
  "dependencies": {
    "@echo-agent/core": "workspace:*",
    "@earendil-works/pi-tui": "^0.84.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test test",
    "start": "bun bin/echo-agent.ts"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin",
    "vendor",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "agent",
    "ai-agent",
    "llm",
    "llm-agent",
    "cli",
    "tui",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echo-yiyi/echo-agent.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/echo-yiyi/echo-agent#readme",
  "bugs": "https://github.com/echo-yiyi/echo-agent/issues",
  "engines": {
    "bun": ">=1.3.0"
  }
}
