{
  "name": "@echo-agent/base",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Echo's assembly layer: the launcher parts, the product contract, the shell port, host capabilities and the pipe form. No terminal dependency — a web or desktop product depends on this and brings its own shell. Requires Bun.",
  "dependencies": {
    "@echo-agent/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test test"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "vendor",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "agent",
    "ai-agent",
    "llm",
    "llm-agent",
    "cli",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echo-yiyi/echo-agent.git",
    "directory": "packages/base"
  },
  "homepage": "https://github.com/echo-yiyi/echo-agent#readme",
  "bugs": "https://github.com/echo-yiyi/echo-agent/issues",
  "engines": {
    "bun": ">=1.3.0"
  }
}
