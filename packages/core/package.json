{
  "name": "@echo-agent/core",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "The Echo agent runtime and SDK: a persistent agent — state machine, commands, events — and its pure loop. Zero runtime dependencies; the Agent owns the mechanism while you supply the ports and the policy.",
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./background": {
      "bun": "./src/background/public.ts",
      "types": "./dist/background/public.d.ts",
      "import": "./dist/background/public.js",
      "default": "./dist/background/public.js"
    },
    "./extension": {
      "bun": "./src/extension/public.ts",
      "types": "./dist/extension/public.d.ts",
      "import": "./dist/extension/public.js",
      "default": "./dist/extension/public.js"
    },
    "./mcp": {
      "bun": "./src/mcp/port.ts",
      "types": "./dist/mcp/port.d.ts",
      "import": "./dist/mcp/port.js",
      "default": "./dist/mcp/port.js"
    },
    "./observability": {
      "bun": "./src/observability/public.ts",
      "types": "./dist/observability/public.d.ts",
      "import": "./dist/observability/public.js",
      "default": "./dist/observability/public.js"
    },
    "./package.json": "./package.json",
    "./task": {
      "bun": "./src/task/public.ts",
      "types": "./dist/task/public.d.ts",
      "import": "./dist/task/public.js",
      "default": "./dist/task/public.js"
    },
    "./task/fs": {
      "bun": "./src/task/fs.ts",
      "types": "./dist/task/fs.d.ts",
      "import": "./dist/task/fs.js",
      "default": "./dist/task/fs.js"
    },
    "./testing": {
      "bun": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./tools": {
      "bun": "./src/tools/public.ts",
      "types": "./dist/tools/public.d.ts",
      "import": "./dist/tools/public.js",
      "default": "./dist/tools/public.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test test"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "agent",
    "ai-agent",
    "llm",
    "llm-agent",
    "agent-runtime",
    "sdk",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echo-yiyi/echo-agent.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/echo-yiyi/echo-agent#readme",
  "bugs": "https://github.com/echo-yiyi/echo-agent/issues"
}
