    "@echo-agent/base": "workspace:*",
    "@echo-agent/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test test"
  },
  "exports": {
